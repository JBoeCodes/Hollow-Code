{
  "about": "Shared by src/canvas/askAnswer.test.ts (readCanvasAnswers) and src-tauri/src/canvas_answers.rs (answered): which canvas revisions a user message answers, as `id@revision`, in order. Canvas C4 A3.",
  "cases": [
    {
      "name": "the composer text an ask-canvas drafts",
      "text": "Answered canvas \"release-choices\":\n- When should the release ship?: Friday\n\n```hollow-canvas-answer\n{\"canvasId\":\"release-choices\",\"revision\":1,\"answers\":{\"ship-day\":\"Friday\",\"checks\":[\"Bed rows\"],\"budget\":24,\"fit\":{\"Speed\":\"High\"},\"notes\":null}}\n```",
      "answered": [
        "release-choices@1"
      ]
    },
    {
      "name": "two blocks in one message, in order",
      "text": "```hollow-canvas-answer\n{\"canvasId\":\"first\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n```\nand\n```hollow-canvas-answer\n{\"canvasId\":\"second\",\"revision\":3,\"answers\":{\"pick\":\"A\"}}\n```",
      "answered": [
        "first@1",
        "second@3"
      ]
    },
    {
      "name": "a block left open at the end still counts",
      "text": "Answered canvas \"a\":\n- Pick: A\n\n```hollow-canvas-answer\n{\"canvasId\":\"a\",\"revision\":2,\"answers\":{\"pick\":\"A\"}}",
      "answered": [
        "a@2"
      ]
    },
    {
      "name": "a tilde fence, an indented fence and an upper-case language",
      "text": "~~~hollow-canvas-answer\n{\"canvasId\":\"tilde\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n~~~\n  ```hollow-canvas-answer\n{\"canvasId\":\"indented\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n```\n```HOLLOW-CANVAS-ANSWER\n{\"canvasId\":\"upper\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n```",
      "answered": [
        "tilde@1",
        "indented@1",
        "upper@1"
      ]
    },
    {
      "name": "a longer fence closes only on one at least as long",
      "text": "````hollow-canvas-answer\n{\"canvasId\":\"long\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n```\n````",
      "answered": []
    },
    {
      "name": "a block quoted inside another fence is text, not an answer",
      "text": "See:\n````md\n```hollow-canvas-answer\n{\"canvasId\":\"quoted\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n```\n````",
      "answered": []
    },
    {
      "name": "an info string after the language is no hidden block",
      "text": "```hollow-canvas-answer json\n{\"canvasId\":\"info\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n```",
      "answered": []
    },
    {
      "name": "another language is not an answer",
      "text": "```json\n{\"canvasId\":\"other\",\"revision\":1,\"answers\":{\"pick\":\"A\"}}\n```",
      "answered": []
    },
    {
      "name": "a whole-number revision written 2.0 is revision 2",
      "text": "```hollow-canvas-answer\n{\"canvasId\":\"float\",\"revision\":2.0,\"answers\":{}}\n```",
      "answered": [
        "float@2"
      ]
    },
    {
      "name": "every value shape the ask kit gives",
      "text": "```hollow-canvas-answer\n{\"canvasId\":\"shapes\",\"revision\":4,\"answers\":{\"a\":\"text\",\"b\":3.5,\"c\":-2,\"d\":[],\"e\":[\"x\",\"y\"],\"f\":{},\"g\":{\"Row\":\"High\"},\"h\":null,\"i.j_k-l\":\"ok\"}}\n```",
      "answered": [
        "shapes@4"
